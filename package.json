{
  "name": "@referalli/mcp",
  "version": "0.1.0",
  "description": "Referalli MCP server: read and run your referral and affiliate program from Claude, Cursor and any MCP client.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "bin": {
    "referalli-mcp": "./dist/bin/referalli-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "referalli",
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "referral",
    "affiliate"
  ],
  "homepage": "https://referalli.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Referalli/referalli-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Referalli/referalli-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin/referalli-mcp.js",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "tsx bin/referalli-mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
